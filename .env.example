# Local web agent: Groq runs in the host process. LangSmith tracing is optional.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Pivot
SANDBOX_DOCKER_IMAGE=data-agent-eda:checkpoint

LANGSMITH_AGENT_ID=agent
LANGSMITH_AGENT_ENVIRONMENT=production
MANAGED_DEEP_AGENT_ID=

# Host-side source credentials. Database host/name/user/port are in scripts/db_cn.py.
DB_Password=
API_HEADERS={}
